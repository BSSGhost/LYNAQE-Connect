# ---------- Serveur ----------
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=false


# ---------- MySQL (serveur uniquement) ----------
# MySQL 8.0 est déjà installé sur cette machine (service MySQL80).
# NE PAS installer MySQL une seconde fois.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lynaqe_connect
DB_USER=root
DB_PASSWORD=BSS_Ghost2010
DB_CREATE_IF_MISSING=true
DB_CONNECTION_LIMIT=10
DB_SSL=false


# ---------- Administration (serveur uniquement) ----------
# Hash scrypt du mot de passe administrateur.
# Généré par : npm run hash-password
# Le mot de passe en clair ne figure nulle part dans le projet.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$aRkVd_dRMRXTuNO_-6k6bw$DBP9bYkDe9E01y1YkIQCb3vjBmWIoy6PXL7fd9hHiOaa1FFRBtr0ifqaTMznfnTVKmbz0ncgp1zgDKkNP8n7YA
ADMIN_SESSION_TTL=43200
JWT_SECRET=JHHFEBV2IUh6XvB9u7pjmuYSxSa4ym5vrWB2WRzOvhy-aXawnpmmcYSO7aIySwe4
JWT_ISSUER=lynaqe-connect


# ---------- Limitation de débit ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_PUBLIC=60
RATE_LIMIT_MAX_SUBMIT=8
RATE_LIMIT_MAX_TRACKING=15
RATE_LIMIT_MAX_SUPPORT=120
RATE_LIMIT_MAX_LOGIN=10
RATE_LIMIT_MAX_ADMIN=600


# ---------- Journalisation ----------
LOG_LEVEL=debug
