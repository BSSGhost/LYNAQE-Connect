# ============================================================
#  LYNAQE Connect — variables d'environnement pour RENDER
# ============================================================
#  Ce fichier est un MODELE VIDE : il ne contient aucun secret.
#
#  Ou saisir ces variables ? Dans l'interface Render :
#    Dashboard > votre service > Environment > Add Environment Variable
#
#  Render ne lit aucun fichier .env : les variables se saisissent
#  une par une dans l'interface du tableau de bord, qui les chiffre.
#
#  ⚠️ Ne JAMAIS commiter un .env contenant les valeurs réelles.
#     Seul ce modèle vide doit être versionné.
# ============================================================


# ---------- Runtime ----------
# `production` : journal en `info`, TRUST_PROXY à true, et refus
# de démarrer si une variable critique est absente.
NODE_ENV=production

# ⚠️ LA variable la plus importante. Render route le trafic vers
#    l'application via 0.0.0.0. La laisser sur 127.0.0.1 rend le
#    site inaccessible, SANS erreur visible dans les logs.
#    Le serveur écrit un avertissement explicite au démarrage.
HOST=0.0.0.0

# ⚠️ NE PAS définir PORT : Render l'injecte lui-même.
#    Une valeur fixe ici rend le démarrage aléatoire.

# URL publique finale : remplacez par votre vrai domaine Render.
APP_URL=https://lynaqe-connect.onrender.com

# Origines autorisées : votre domaine public uniquement.
CORS_ORIGINS=https://lynaqe-connect.onrender.com

# Indispensable derrière le proxy Render : sans cela, les quotas
# de sécurité comptent TOUS les visiteurs comme une seule IP.
TRUST_PROXY=true


# ---------- MySQL managé (Aiven ou équivalent) ----------
# Valeurs dans le panneau du fournisseur, section Connection.
DB_HOST=votre-hote.mysql.aivencloud.com
DB_PORT=10306
DB_NAME=defaultdb
DB_USER=utilisateur_fourni
DB_PASSWORD=

# OBLIGATOIRE chez Aiven et la plupart des fournisseurs managés.
DB_SSL=true

# La base existe déjà (fournie par le fournisseur) : ne pas tenter
# de la créer, le compte n'a pas ce droit et le démarrage échouerait.
DB_CREATE_IF_MISSING=false

# 5 connexions : Render peut lancer plusieurs instances à froid.
# Restez sous la limite du palier gratuit.
DB_CONNECTION_LIMIT=5


# ---------- Administration ----------
# Générez le hash SUR VOTRE MACHINE :
#   cd backend && npm run hash-password -- "ton mot de passe"
# Puis copiez le hash obtenu ici.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
ADMIN_SESSION_TTL=43200

# Générez SUR VOTRE MACHINE :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ⚠️ NE RÉUTILISEZ JAMAIS le JWT_SECRET de votre .env local :
#    un secret partagé entre deux environnements est compromis.
JWT_SECRET=
JWT_ISSUER=lynaqe-connect


# ---------- Photos privées ----------
# Configurez cette variable vers un volume persistant hors du frontend.
# Exemple VPS : /var/lib/lynaqe-connect/suggestion-photos
# Le disque local Render est éphémère sans disque persistant attaché.
PHOTO_STORAGE_DIR=


# ---------- Limitation de débit ----------
# ⚠️ Ces quotas sont stockés en mémoire dans chaque instance. Sur
#    Render, une instance froide repart avec ses quotas à zéro : la
#    protection reste utile mais approximative.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_PUBLIC=60
RATE_LIMIT_MAX_SUBMIT=8
RATE_LIMIT_MAX_TRACKING=15
RATE_LIMIT_MAX_SUPPORT=120
RATE_LIMIT_MAX_LOGIN=10
RATE_LIMIT_MAX_ADMIN=600


# ---------- Journalisation ----------
# `info` en production. Les logs apparaissent dans les logs Render.
LOG_LEVEL=info
