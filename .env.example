# ============================================================
#  LYNAQE Connect — variables d'environnement (EXEMPLE)
# ============================================================
#  Copiez ce fichier en `.env` a la racine du projet puis adaptez
#  les valeurs a votre configuration MySQL locale.
#
#  ⚠ `.env` est ignore par git. NE JAMAIS commiter le vrai
#    mot de passe MySQL ni le mot de passe administrateur.
# ============================================================


# ---------- Serveur ----------
NODE_ENV=development
PORT=3000
# Adresse d'ecoute. 127.0.0.1 = uniquement local (recommande en dev).
HOST=127.0.0.1
# URL publique utilisee dans les messages et CORS. Separateur de liste.
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ---------- MySQL (serveur uniquement, jamais expose au navigateur) ----------
# MySQL est deja installe sur la machine : ne pas l'installer une seconde fois.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lynaqe_connect
DB_USER=root
# ⚠ Remplacez par le VRAI mot de passe de votre utilisateur MySQL local.
DB_PASSWORD=
# Cree automatiquement par `npm run migrate` si absent (privileges requis).
DB_CREATE_IF_MISSING=true
DB_CONNECTION_LIMIT=10
DB_SSL=false


# ---------- Administration (serveur uniquement) ----------
# Mot de passe administrateur en clair. Utilise uniquement au demarrage
# pour deriver le hash ci-dessous. NE JAMAIS l'exposer au frontend.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# Duree de validite de la session administrateur (secondes).
ADMIN_SESSION_TTL=43200
# Secret de signature des jetons de session. Generez-le avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ISSUER=lynaqe-connect


# ---------- Photos privées ----------
# Répertoire hors du frontend, persistant en production.
# Le chemin relatif est résolu depuis la racine du dépôt.
PHOTO_STORAGE_DIR=backend/data/suggestion-photos


# ---------- Limitation de debit ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_PUBLIC=60
RATE_LIMIT_MAX_SUBMIT=8
RATE_LIMIT_MAX_TRACKING=15
RATE_LIMIT_MAX_SUPPORT=120
RATE_LIMIT_MAX_LOGIN=10
RATE_LIMIT_MAX_ADMIN=600


# ---------- Journalisation ----------
LOG_LEVEL=info
